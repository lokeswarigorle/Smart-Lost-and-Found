# Django Settings
DJANGO_SECRET_KEY=your-super-secret-django-key-here
DJANGO_DEBUG=True

# MySQL Database Configuration
DB_NAME=lost_found_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# AI Matching Weights (must sum to approx 1.0)
MATCH_WEIGHT_IMAGE=0.60
MATCH_WEIGHT_CATEGORY=0.15
MATCH_WEIGHT_COLOR=0.10
MATCH_WEIGHT_DESC=0.10
MATCH_WEIGHT_LOCATION=0.05
CLIP_MODEL_NAME=openai/clip-vit-base-patch32

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_password
DEFAULT_FROM_EMAIL=Smart Lost & Found <noreply@smartlostfound.local>
